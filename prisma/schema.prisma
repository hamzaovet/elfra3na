datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String?  @unique
  passwordHash String?
  phone        String   @unique
  pin          String   @default("123456")
  role         String   @default("cashier") // owner, cashier, manager, delivery
  branch       String   @default("فرع فيصل الرئيسي")
  avatar       String?
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique // فرع فيصل الرئيسي، فرع ألف مسكن، فرع 6 أكتوبر، فرع حدائق القبة، فرع زهراء المعادي
  city        String   @default("القاهرة والجيزة")
  address     String
  phone       String
  managerName String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  nameAr      String    @unique
  nameEn      String?
  emoji       String?
  image       String?
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String    @id @default(cuid())
  nameAr         String
  nameEn         String
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  categoryName   String?   @default("فسيخ ورنجة")
  basePrice      Float
  originalPrice  Float?    // السعر الأصلي المشطوب (e.g. 480 EGP)
  promoPrice     Float?    // سعر العرض (e.g. 420 EGP)
  promoDays      String?   // أيام العرض
  promoActive    Boolean   @default(false)
  isFlashDeal    Boolean   @default(false)
  isWeightItem   Boolean   @default(false) // صنف يباع بالوزن (كيلو / جرام)
  scaleItemCode  String?   // كود الميزان PLU e.g. 00001
  weightUnit     String?   @default("كيلو") // كيلو، برطمان، طبق، علبة، بوكس
  sizes          String?   // JSON: [{nameAr, nameEn, price, weightGrams}] (ربع كيلو 250جم، نصف كيلو 500جم، كيلو كامل 1000جم، برطمان)
  modifiers      String?   // JSON: [{nameAr, nameEn, price}] (زيت حار، ليمون إضافي، فلفل بلدي حامي، سلطة طحينة)
  packageType    String?   @default("مخلي جاهز للأكل") // مخلي بزيت وليمون، سليم بالجلد، برطمان زجاجي، صينية عائلية
  trayComponents String?   // JSON: مكونات البوكس أو الصينية
  image          String?
  description    String?
  isAvailable    Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String?
  branch        String   @default("فرع فيصل الرئيسي")
  zone          String   @default("فيصل والهرم")
  orderType     String   @default("delivery") // delivery (دليفري للمنزل), takeaway (استلام من الفرع), pos (صالة / كاشير المحل)
  status        String   @default("new") // new, preparing, ready, with_captain, delivered, cancelled
  items         String   // JSON: [{productId, nameAr, nameEn, qty, unitPrice, selectedSize, packageType, extras:[], total}]
  subtotal      Float
  deliveryFee   Float    @default(0)
  total         Float
  deposit       Float    @default(0)
  remaining     Float
  paymentMethod String   @default("cash") // cash, instapay, wallet, card
  notes         String?
  cashierName   String?
  captainName   String?  // الطيار المسؤول عن التوصيل
  captainPhone  String?  // رقم هاتف الطيار
  customerEmail String?
  customerId    String?
  timeline      String   @default("[]") // JSON: [{stage, at, by}]
  saro5RefId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?  @unique
  address       String?
  zone          String?
  branch        String?
  loyaltyPoints Int      @default(0)
  notes         String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Captain {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  branch         String   @default("فرع فيصل الرئيسي")
  vehicle        String?  @default("سكوتر / موتوسيكل")
  isActive       Boolean  @default(true)
  currentOrders  Int      @default(0)
  totalDelivered Int      @default(0)
  createdAt      DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  expenseDate String   // YYYY-MM-DD
  category    String   @default("تشغيل") // خامات، أسماك، تشغيل، مرتبات، إيجار، نظافة
  branch      String   @default("فرع فيصل الرئيسي")
  recordedBy  String?
  createdAt   DateTime @default(now())
}

model TreasuryTransaction {
  id              String   @id @default(cuid())
  transactionDate DateTime @default(now())
  type            String   // IN | OUT
  category        String   // SALE, EXPENSE, OPENING, OTHER
  amount          Float
  description     String
  reference       String?
  paymentMethod   String   @default("cash")
  branch          String   @default("فرع فيصل الرئيسي")
  createdBy       String   @default("system")
  createdAt       DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(cuid())
  senderId      String?
  senderName    String
  senderRole    String?
  text          String
  orderId       String?
  customerPhone String?
  isStaff       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model SystemSettings {
  id                    String   @id @default("default")
  restaurantName        String   @default("فسيخ ورنجة الفراعنة")
  phone                 String   @default("01000388911")
  hotlines              String   @default("01000388911 | 01069717413 | 01110022334")
  address               String   @default("الفروع: فيصل، ألف مسكن، 6 أكتوبر، حدائق القبة، زهراء المعادي")
  whatsappNumber        String   @default("01069717413")
  deliveryZones         String   @default("[]") // JSON: [{name, fee}]
  openingCashBalance    Float    @default(0.0)
  receiptHeader         String   @default("فسيخ ورنجة الفراعنة - ملوك الأسماك المملحة والمدخنة")
  receiptFooter         String   @default("ألف هنا وشفا - شكراً لزيارتكم فسيخ ورنجة الفراعنة • دليفري 01000388911")
  receiptWidth          String   @default("80mm")
  autoPrintReceipt      Boolean  @default(true)
  soundsEnabled         Boolean  @default(true)
  offersEnabled         Boolean  @default(true)
  specialOffers         String?
  isLockedDown          Boolean  @default(false)
  whatsappOrdersEnabled Boolean  @default(true)
  ownerWhatsapp         String?  @default("01069717413")
  saro5WebhookUrl       String?
  talabatWebhookUrl     String?
  updatedAt             DateTime @updatedAt
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("كجم")
  quantity    Float    @default(0)
  minStock    Float    @default(1)
  costPerUnit Float    @default(0)
  createdAt   DateTime @default(now())
}

model InventoryAudit {
  id          String   @id @default(cuid())
  title       String
  periodStart String?
  periodEnd   String?
  totalCost   Float
  itemsCount  Int      @default(0)
  items       String   // JSON
  recordedBy  String?
  expenseId   String?
  createdAt   DateTime @default(now())
}

model Purchase {
  id             String   @id @default(cuid())
  ingredientId   String
  ingredientName String
  quantity       Float
  unitPrice      Float
  totalCost      Float
  prevQty        Float
  newQty         Float
  prevCost       Float
  newAvgCost     Float
  supplier       String?
  invoiceNo      String?
  invoiceNumber  String?
  notes          String?
  recordedBy     String?
  expenseId      String?
  createdAt      DateTime @default(now())
}

model DeliveryZone {
  id          String   @id @default(cuid())
  code        String?
  nameAr      String
  nameEn      String
  branch      String   @default("فرع فيصل الرئيسي")
  fee         Float
  timeMinutes Int      @default(45)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
